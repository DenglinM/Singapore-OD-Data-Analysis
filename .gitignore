# =========================================================
# Data: never commit raw or intermediate data (large files / licence terms)
# How to obtain the data is documented in data/README.md
# =========================================================
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Large data files and archives anywhere in the repo
*.zip
*.7z
*.rar
*.parquet
*.feather

# =========================================================
# R / RStudio
# =========================================================
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
*-Ex.R
/*.tar.gz
/*.Rcheck/

# knitr / R Markdown / Quarto caches and intermediate files
*_cache/
/cache/
*.utf8.md
*.knit.md
/.quarto/
*_files/

# Secrets / environment variables (e.g. the LTA DataMall AccountKey)
.Renviron
.env
.httr-oauth

# renv local library (commit renv.lock, not the library itself)
renv/library/
renv/local/
renv/staging/
renv/cellar/
renv/python/

rsconnect/
po/*~

# =========================================================
# QGIS
# Project files (.qgs/.qgz), styles (.qml) and layouts (.qpt) may be committed;
# the patterns below are backups and temporary files
# =========================================================
*.qgs~
*.qgz~
*.gpkg-wal
*.gpkg-shm
*.gpkg-journal
*.lock
!renv.lock

# =========================================================
# Outputs: figures and small tables may be committed; large files may not
# =========================================================
outputs/**/*.tif
outputs/**/*.tiff
outputs/**/*.gpkg
outputs/**/*.shp
outputs/**/*.shx
outputs/**/*.dbf
outputs/**/*.prj
outputs/**/*.cpg

# =========================================================
# OS / editor files
# =========================================================
.DS_Store
Thumbs.db
desktop.ini
~$*
.vscode/
.idea/
