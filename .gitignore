# =========================================================
# 数据文件：原始数据和中间数据一律不提交（体积大 / 可能有使用许可限制）
# 数据获取方式写在 data/README.md
# =========================================================
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# 仓库任何位置的大型数据 / 压缩包
*.zip
*.7z
*.rar
*.parquet
*.feather

# =========================================================
# R / RStudio
# =========================================================
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
*-Ex.R
/*.tar.gz
/*.Rcheck/

# knitr / R Markdown / Quarto 缓存与中间文件
*_cache/
/cache/
*.utf8.md
*.knit.md
/.quarto/
*_files/

# 密钥 / 环境变量（例如 LTA DataMall 的 AccountKey）
.Renviron
.env
.httr-oauth

# renv 本地库（renv.lock 需要提交，库本身不提交）
renv/library/
renv/local/
renv/staging/
renv/cellar/
renv/python/

rsconnect/
po/*~

# =========================================================
# QGIS
# 工程文件 .qgs/.qgz、样式 .qml、布局 .qpt 可以提交；以下为备份和临时文件
# =========================================================
*.qgs~
*.qgz~
*.gpkg-wal
*.gpkg-shm
*.gpkg-journal
*.lock
!renv.lock

# =========================================================
# 输出：图表和小表格可以提交；大文件请勿提交
# =========================================================
outputs/**/*.tif
outputs/**/*.tiff
outputs/**/*.gpkg
outputs/**/*.shp
outputs/**/*.shx
outputs/**/*.dbf
outputs/**/*.prj
outputs/**/*.cpg

# =========================================================
# 系统 / 编辑器
# =========================================================
.DS_Store
Thumbs.db
desktop.ini
~$*
.vscode/
.idea/
